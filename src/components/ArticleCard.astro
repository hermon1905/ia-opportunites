---
/**
 * Carte d'article réutilisable (Untitled UI inspired).
 * Affiche l'image optimisée, la catégorie, le temps de lecture,
 * le titre avec flèche au survol, l'extrait, l'auteur et la date.
 */
import { Picture } from 'astro:assets';
import type { Post } from '../utils/posts';
import { readingTime, formatDate } from '../utils/posts';
import { getCategory, CATEGORY_STYLES } from '../data/categories';
import { getAuthor } from '../data/authors';

interface Props {
	post: Post;
	featured?: boolean;
	class?: string;
}

const { post, featured = false, class: className = '' } = Astro.props;
const category = getCategory(post.data.category)!;
const author = getAuthor(post.data.author);
const minutes = readingTime(post.body);
---

<article
	class:list={[
		'group flex flex-col overflow-hidden rounded-2xl border border-bordure/80 bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-accent/5',
		featured ? 'md:grid md:grid-cols-12 md:rounded-3xl' : '',
		className,
	]}
>
	<!-- Image d'illustration -->
	<a
		href={`/blog/${post.id}`}
		class:list={[
			'block overflow-hidden bg-surface-2',
			featured ? 'aspect-video md:aspect-auto md:col-span-7' : 'aspect-video',
		]}
	>
		<Picture
			src={post.data.image}
			alt={post.data.imageAlt}
			widths={featured ? [480, 800, 1200] : [360, 600]}
			sizes={
				featured
					? '(max-width: 768px) 100vw, 60vw'
					: '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'
			}
			formats={['avif', 'webp']}
			class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
			loading={featured ? 'eager' : 'lazy'}
			fetchpriority={featured ? 'high' : 'auto'}
		/>
	</a>

	<!-- Corps de la carte -->
	<div
		class:list={[
			'flex flex-1 flex-col justify-between',
			featured ? 'p-6 sm:p-10 md:col-span-5' : 'p-6',
		]}
	>
		<div>
			<!-- Catégorie + temps de lecture -->
			<div class="flex items-center justify-between gap-2">
				<a
					href={`/categorie/${category.slug}`}
					class:list={['etiquette transition hover:opacity-85', CATEGORY_STYLES[category.color]]}
				>
					{category.name}
				</a>
				<span class="inline-flex items-center gap-1 text-xs text-attenue">
					<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					{minutes} min
				</span>
			</div>

			<!-- Titre avec flèche ↗ au survol -->
			<h3
				class:list={[
					'mt-3 font-semibold leading-snug text-texte transition group-hover:text-accent',
					featured ? 'text-2xl sm:text-3xl' : 'text-xl',
				]}
			>
				<a href={`/blog/${post.id}`} class="inline-flex items-start gap-1.5 focus:outline-none">
					<span>{post.data.title}</span>
					<span
						aria-hidden="true"
						class="inline-block transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-accent"
					>
						&nearr;
					</span>
				</a>
			</h3>

			<!-- Description / Extrait -->
			<p
				class:list={[
					'mt-2.5 text-attenue',
					featured ? 'text-sm leading-relaxed sm:text-base' : 'line-clamp-2 text-sm',
				]}
			>
				{post.data.description}
			</p>
		</div>

		<!-- Auteur & Date -->
		<div class="mt-6 flex items-center justify-between border-t border-bordure/60 pt-4 text-xs text-attenue">
			<span class="font-medium">{author.name}</span>
			<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
		</div>
	</div>
</article>

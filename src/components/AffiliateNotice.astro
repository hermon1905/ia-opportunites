---
/**
 * Mention de transparence d'affiliation conforme aux exigences légales (ARPP, DGCCRF, FTC).
 * À insérer au début d'un article ou comparatif contenant des liens partenaires.
 */
import { AFFILIATE } from '../config';

interface Props {
	customText?: string;
	class?: string;
}

const { customText, class: className = '' } = Astro.props;
const text = customText ?? AFFILIATE.disclaimer;
---

<aside
	aria-label="Transparence des liens affiliés"
	class:list={[
		'my-6 flex items-start gap-3 rounded-2xl border border-bordure bg-surface-2/50 p-4 text-xs leading-relaxed text-attenue backdrop-blur-sm',
		className,
	]}
>
	<div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
		<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<line x1="12" y1="16" x2="12" y2="12" />
			<line x1="12" y1="8" x2="12.01" y2="8" />
		</svg>
	</div>
	<p class="flex-1">
		{text}
	</p>
</aside>

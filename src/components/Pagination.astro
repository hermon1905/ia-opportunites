---
/**
 * Composant de pagination (Précédent / Numéros / Suivant).
 * Inspiré d'Untitled UI avec styles accessibles et mode sombre.
 */
interface Props {
	currentPage: number;
	lastPage: number;
	prevUrl?: string;
	nextUrl?: string;
	baseUrl?: string;
	class?: string;
}

const {
	currentPage,
	lastPage,
	prevUrl,
	nextUrl,
	baseUrl = '/blog',
	class: className = '',
} = Astro.props;

// Génère les numéros de page à afficher
function getPageNumbers(current: number, total: number) {
	if (total <= 7) {
		return Array.from({ length: total }, (_, i) => i + 1);
	}
	const pages: (number | string)[] = [];
	pages.push(1);
	if (current > 3) pages.push('...');
	const start = Math.max(2, current - 1);
	const end = Math.min(total - 1, current + 1);
	for (let i = start; i <= end; i++) {
		pages.push(i);
	}
	if (current < total - 2) pages.push('...');
	pages.push(total);
	return pages;
}

const pageNumbers = getPageNumbers(currentPage, lastPage);

function getUrlForPage(num: number) {
	if (num === 1) return baseUrl;
	const cleanBase = baseUrl.replace(/\/$/, '');
	return `${cleanBase}/${num}`;
}
---

{lastPage > 1 && (
	<nav
		aria-label="Pagination"
		class:list={[
			'mt-12 flex flex-col items-center justify-between gap-4 border-t border-bordure pt-6 sm:flex-row',
			className,
		]}
	>
		<!-- Bouton Précédent -->
		<div>
			{prevUrl ? (
				<a
					href={prevUrl}
					class="btn-secondaire text-xs sm:text-sm"
					rel="prev"
				>
					&larr; Précédent
				</a>
			) : (
				<span class="btn-secondaire cursor-not-allowed opacity-40 text-xs sm:text-sm">
					&larr; Précédent
				</span>
			)}
		</div>

		<!-- Numéros de pages -->
		<div class="flex items-center gap-1">
			{pageNumbers.map((num) => {
				if (num === '...') {
					return <span class="px-2 text-xs text-attenue">...</span>;
				}
				const isCurrent = num === currentPage;
				const url = getUrlForPage(num as number);

				return isCurrent ? (
					<span
						aria-current="page"
						class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent text-xs font-semibold text-white shadow-sm dark:text-sable-950"
					>
						{num}
					</span>
				) : (
					<a
						href={url}
						class="flex h-9 w-9 items-center justify-center rounded-xl text-xs font-medium text-texte transition hover:bg-surface-2"
					>
						{num}
					</a>
				);
			})}
		</div>

		<!-- Bouton Suivant -->
		<div>
			{nextUrl ? (
				<a
					href={nextUrl}
					class="btn-secondaire text-xs sm:text-sm"
					rel="next"
				>
					Suivant &rarr;
				</a>
			) : (
				<span class="btn-secondaire cursor-not-allowed opacity-40 text-xs sm:text-sm">
					Suivant &rarr;
				</span>
			)}
		</div>
	</nav>
)}

---
/**
 * Bandeau de consentement cookies conforme au RGPD et à la directive ePrivacy.
 * - Mémorise le choix dans le navigateur (localStorage).
 * - Réouvrable à tout moment via le lien « Gérer les cookies » du pied de page.
 * - Design soigné inspiré d'Untitled UI, compact et non-intrusif.
 */
---

<div
	id="cookie-banner"
	role="dialog"
	aria-live="polite"
	aria-label="Gestion des cookies et confidentialité"
	class="fixed bottom-4 left-4 right-4 z-50 mx-auto hidden max-w-lg rounded-3xl border border-bordure bg-surface/95 p-5 shadow-2xl backdrop-blur-md transition-all duration-300 sm:bottom-6 sm:right-6 sm:left-auto sm:p-6"
>
	<div class="flex items-start gap-4">
		<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-amber-500/10 text-xl text-amber-600 dark:bg-amber-500/20 dark:text-amber-400">
			🍪
		</div>

		<div class="flex-1">
			<h3 class="text-sm font-semibold text-texte">Respect de votre vie privée</h3>
			<p class="mt-1 text-xs leading-relaxed text-attenue">
				Nous utilisons des cookies strictement nécessaires et des mesures d'audience anonymes pour améliorer votre lecture, sans revente de données.
				<a href="/confidentialite" class="font-medium text-accent hover:underline">
					Politique de confidentialité
				</a>
			</p>

			<div class="mt-4 flex flex-wrap items-center gap-2">
				<button
					type="button"
					id="cookie-accept"
					class="btn-primaire px-4 py-2 text-xs font-semibold"
				>
					Accepter
				</button>
				<button
					type="button"
					id="cookie-decline"
					class="btn-secondaire px-4 py-2 text-xs font-medium"
				>
					Continuer sans accepter
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	function initCookieBanner() {
		const banner = document.getElementById('cookie-banner');
		const acceptBtn = document.getElementById('cookie-accept');
		const declineBtn = document.getElementById('cookie-decline');
		const triggers = document.querySelectorAll('[data-cookie-settings]');

		if (!banner) return;

		const consent = localStorage.getItem('cookie-consent');
		if (!consent) {
			banner.classList.remove('hidden');
		}

		const saveChoice = (choice: 'accepted' | 'declined') => {
			localStorage.setItem('cookie-consent', choice);
			banner.classList.add('hidden');
			window.dispatchEvent(new CustomEvent('cookie-consent-updated', { detail: { choice } }));
		};

		acceptBtn?.addEventListener('click', () => saveChoice('accepted'));
		declineBtn?.addEventListener('click', () => saveChoice('declined'));

		// Permet de ré-ouvrir le bandeau depuis le lien "Gérer les cookies" dans le footer
		triggers.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				banner.classList.remove('hidden');
				banner.scrollIntoView({ behavior: 'smooth' });
			});
		});
	}

	initCookieBanner();
	document.addEventListener('astro:page-load', initCookieBanner);
</script>

---
/**
 * Composant SEO universel :
 * - Balises meta classiques (title, description, canonical)
 * - Open Graph (Facebook, WhatsApp, LinkedIn)
 * - Twitter Card (X)
 * - Flux RSS et Sitemap
 * - Données structurées Schema.org JSON-LD (WebSite, BlogPosting)
 */
import type { ImageMetadata } from 'astro';
import { SITE, SOCIAL } from '../config';

interface Props {
	title?: string;
	description?: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	author?: string;
	category?: string;
	tags?: string[];
	canonicalUrl?: string;
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	image,
	imageAlt = SITE.name,
	type = 'website',
	publishedTime,
	modifiedTime,
	author = SITE.author,
	category,
	tags = [],
	canonicalUrl,
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://ia-opportunites.pages.dev');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const canonical = canonicalUrl ?? pageUrl;

const pageTitle = title
	? `${title} | ${SITE.name}`
	: `${SITE.name} — ${SITE.tagline}`;

// Résolution de l'URL de l'image de partage (Open Graph / Twitter)
let ogImageHref = '/og-image.jpg';
if (typeof image === 'string') {
	ogImageHref = image;
} else if (image && typeof image === 'object' && 'src' in image) {
	ogImageHref = image.src;
}
const ogImageUrl = new URL(ogImageHref, siteUrl).href;

// Données structurées JSON-LD pour Google
const schemaWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.name,
	url: siteUrl.href,
	description: SITE.description,
	inLanguage: SITE.lang,
};

const schemaArticle =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				mainEntityOfPage: {
					'@type': 'WebPage',
					'@id': canonical,
				},
				headline: title,
				description: description,
				image: ogImageUrl,
				datePublished: publishedTime ? publishedTime.toISOString() : undefined,
				dateModified: modifiedTime
					? modifiedTime.toISOString()
					: publishedTime
						? publishedTime.toISOString()
						: undefined,
				author: {
					'@type': 'Person',
					name: author,
				},
				publisher: {
					'@type': 'Organization',
					name: SITE.name,
					logo: {
						'@type': 'ImageObject',
						url: new URL('/favicon.svg', siteUrl).href,
					},
				},
				articleSection: category,
				keywords: tags.length > 0 ? tags.join(', ') : undefined,
				inLanguage: SITE.lang,
			}
		: null;
---

<!-- Titre et description de base -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex ? (
	<meta name="robots" content="noindex, nofollow" />
) : (
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

{SITE.googleSiteVerification && (
	<meta name="google-site-verification" content={SITE.googleSiteVerification} />
)}

<!-- Découverte RSS et Sitemap -->
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title || SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{type === 'article' && (
	<>
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
		{author && <meta property="article:author" content={author} />}
		{category && <meta property="article:section" content={category} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
	</>
)}

<!-- Twitter Card / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title || SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{SOCIAL.x && <meta name="twitter:site" content={SOCIAL.x} />}

<!-- Données structurées Google (JSON-LD) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaWebsite)} />
{schemaArticle && (
	<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaArticle)} />
)}

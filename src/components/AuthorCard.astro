---
/**
 * Carte de présentation de l'auteur en bas d'article.
 */
import { getAuthor, initials } from '../data/authors';

interface Props {
	authorId: string;
	class?: string;
}

const { authorId, class: className = '' } = Astro.props;
const author = getAuthor(authorId);
const authorInitials = initials(author.name);
---

<div class:list={['my-10 overflow-hidden rounded-2xl border border-bordure bg-surface p-6 sm:p-8', className]}>
	<div class="flex flex-col gap-5 sm:flex-row sm:items-center">
		<!-- Avatar avec initiales stylisées -->
		<div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-terracotta-500 to-ocre-500 text-lg font-bold text-white shadow-md">
			{authorInitials}
		</div>

		<div class="flex-1">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div>
					<p class="text-xs font-semibold uppercase tracking-wider text-accent">{author.role}</p>
					<h3 class="text-lg font-semibold text-texte">{author.name}</h3>
				</div>
				{author.url && (
					<a
						href={author.url}
						class="text-xs font-semibold text-accent hover:underline sm:text-sm"
					>
						En savoir plus &rarr;
					</a>
				)}
			</div>
			<p class="mt-2 text-sm leading-relaxed text-attenue">
				{author.bio}
			</p>
		</div>
	</div>
</div>

---
/**
 * Boutons de partage pour réseaux sociaux et messageries.
 * Inclut WhatsApp, X (Twitter), LinkedIn, Facebook et copie de lien.
 */
interface Props {
	title: string;
	description?: string;
	class?: string;
}

const { title, description = '', class: className = '' } = Astro.props;
---

<div class:list={['my-8 rounded-2xl border border-bordure bg-surface p-5 sm:p-6', className]}>
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<p class="text-xs font-semibold uppercase tracking-wider text-accent">Partager</p>
			<p class="text-sm font-medium text-texte">Cet article peut aider un proche ? Transmettez-le !</p>
		</div>

		<div class="flex flex-wrap items-center gap-2" data-share-container data-title={title} data-desc={description}>
			<!-- Bouton WhatsApp -->
			<a
				href="#"
				data-share="whatsapp"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-xl bg-[#25D366]/10 px-3 py-2 text-xs font-semibold text-[#128C7E] transition hover:bg-[#25D366]/20 dark:bg-[#25D366]/20 dark:text-[#25D366]"
				title="Partager sur WhatsApp"
			>
				<svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.884 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
				</svg>
				<span>WhatsApp</span>
			</a>

			<!-- Bouton X (Twitter) -->
			<a
				href="#"
				data-share="x"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-xl border border-bordure bg-surface px-3 py-2 text-xs font-semibold text-texte transition hover:bg-surface-2"
				title="Partager sur X"
			>
				<svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
				</svg>
				<span>X</span>
			</a>

			<!-- Bouton LinkedIn -->
			<a
				href="#"
				data-share="linkedin"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-xl bg-[#0A66C2]/10 px-3 py-2 text-xs font-semibold text-[#0A66C2] transition hover:bg-[#0A66C2]/20 dark:bg-[#0A66C2]/20 dark:text-[#388bdc]"
				title="Partager sur LinkedIn"
			>
				<svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
				</svg>
				<span>LinkedIn</span>
			</a>

			<!-- Bouton Copier le lien -->
			<button
				type="button"
				data-copy-link
				class="inline-flex items-center gap-2 rounded-xl border border-bordure bg-surface px-3 py-2 text-xs font-semibold text-texte transition hover:bg-surface-2 focus:outline-none"
				title="Copier le lien de l'article"
			>
				<svg data-copy-icon class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
				</svg>
				<svg data-check-icon class="hidden h-4 w-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="20 6 9 17 4 12" />
				</svg>
				<span data-copy-text>Copier le lien</span>
			</button>
		</div>
	</div>
</div>

<script>
	function setupShare() {
		const container = document.querySelector('[data-share-container]');
		if (!container) return;

		const currentUrl = window.location.href;
		const rawTitle = container.getAttribute('data-title') || document.title;
		const title = encodeURIComponent(rawTitle);
		const url = encodeURIComponent(currentUrl);

		const wa = container.querySelector('[data-share="whatsapp"]');
		if (wa) wa.setAttribute('href', `https://api.whatsapp.com/send?text=${title}%20${url}`);

		const x = container.querySelector('[data-share="x"]');
		if (x) x.setAttribute('href', `https://twitter.com/intent/tweet?text=${title}&url=${url}`);

		const li = container.querySelector('[data-share="linkedin"]');
		if (li) li.setAttribute('href', `https://www.linkedin.com/sharing/share-offsite/?url=${url}`);

		const copyBtn = container.querySelector('[data-copy-link]');
		const copyText = container.querySelector('[data-copy-text]');
		const copyIcon = container.querySelector('[data-copy-icon]');
		const checkIcon = container.querySelector('[data-check-icon]');

		if (copyBtn && copyText && copyIcon && checkIcon) {
			copyBtn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(currentUrl);
					copyIcon.classList.add('hidden');
					checkIcon.classList.remove('hidden');
					copyText.textContent = 'Lien copié !';
					setTimeout(() => {
						copyIcon.classList.remove('hidden');
						checkIcon.classList.add('hidden');
						copyText.textContent = 'Copier le lien';
					}, 2500);
				} catch (err) {
					console.error('Erreur lors de la copie', err);
				}
			});
		}
	}

	setupShare();
	document.addEventListener('astro:page-load', setupShare);
</script>

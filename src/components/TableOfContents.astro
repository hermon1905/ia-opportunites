---
/**
 * Sommaire automatique d'un article (Table des matières).
 * Filtre les titres h2 et h3 pour une lecture structurée.
 */
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	class?: string;
}

const { headings, class: className = '' } = Astro.props;

// On ne retient que les sous-titres H2 et H3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{toc.length >= 2 && (
	<aside
		aria-label="Sommaire de l'article"
		class:list={[
			'my-8 rounded-2xl border border-bordure bg-surface-2/60 p-5 sm:p-6 backdrop-blur-sm',
			className,
		]}
	>
		<details class="group" open>
			<summary class="flex cursor-pointer select-none items-center justify-between text-base font-semibold text-texte focus:outline-none">
				<span class="inline-flex items-center gap-2">
					<svg
						class="h-5 w-5 text-accent"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<line x1="8" y1="6" x2="21" y2="6" />
						<line x1="8" y1="12" x2="21" y2="12" />
						<line x1="8" y1="18" x2="21" y2="18" />
						<line x1="3" y1="6" x2="3.01" y2="6" />
						<line x1="3" y1="12" x2="3.01" y2="12" />
						<line x1="3" y1="18" x2="3.01" y2="18" />
					</svg>
					Sommaire de l'article
				</span>
				<div class="flex items-center gap-2 text-xs font-normal text-attenue">
					<span>{toc.length} sections</span>
					<svg
						class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<polyline points="6 9 12 15 18 9" />
					</svg>
				</div>
			</summary>

			<nav class="mt-4 border-t border-bordure/60 pt-4" aria-label="Sections de l'article">
				<ul class="space-y-2 text-sm">
					{toc.map((heading) => (
						<li class:list={[heading.depth === 3 ? 'pl-4 text-xs' : 'font-medium']}>
							<a
								href={`#${heading.slug}`}
								class="inline-block text-attenue transition hover:text-accent focus:text-accent"
							>
								{heading.depth === 3 && (
									<span class="mr-1.5 text-accent/60">↳</span>
								)}
								{heading.text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</details>
	</aside>
)}

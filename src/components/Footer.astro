---
import Logo from './Logo.astro';
import { SITE, FOOTER_LINKS, SOCIAL } from '../config';
import { CATEGORIES } from '../data/categories';

const year = new Date().getFullYear();

// Icônes des réseaux (affichées seulement si un lien est renseigné dans config.ts)
const socials = [
	{ key: 'x', label: 'X (Twitter)', path: 'M17.8 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5.2 21H2l7.3-8.3L1.7 3h6.4l4.4 5.9L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
	{ key: 'linkedin', label: 'LinkedIn', path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5c0-1.2-.02-2.73-1.66-2.73-1.67 0-1.92 1.3-1.92 2.64V21h-4V9.75Z' },
	{ key: 'whatsapp', label: 'WhatsApp', path: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z' },
	{ key: 'youtube', label: 'YouTube', path: 'M23 12s0-3.5-.45-5.2a2.7 2.7 0 0 0-1.9-1.9C19 4.5 12 4.5 12 4.5s-7 0-8.65.4a2.7 2.7 0 0 0-1.9 1.9C1 8.5 1 12 1 12s0 3.5.45 5.2a2.7 2.7 0 0 0 1.9 1.9c1.65.4 8.65.4 8.65.4s7 0 8.65-.4a2.7 2.7 0 0 0 1.9-1.9C23 15.5 23 12 23 12ZM9.75 15.3V8.7L15.5 12l-5.75 3.3Z' },
	{ key: 'instagram', label: 'Instagram', path: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm6.4-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0ZM21.9 8c-.1-1.6-.4-3-1.6-4.2C19 2.5 17.6 2.2 16 2.1 14.4 2 9.6 2 8 2.1 6.4 2.2 5 2.5 3.8 3.7 2.5 5 2.2 6.4 2.1 8 2 9.6 2 14.4 2.1 16c.1 1.6.4 3 1.7 4.2C5 21.5 6.4 21.8 8 21.9c1.6.1 6.4.1 8 0 1.6-.1 3-.4 4.2-1.7 1.3-1.2 1.6-2.6 1.7-4.2.1-1.6.1-6.4 0-8Z' },
	{ key: 'tiktok', label: 'TikTok', path: 'M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-1.8-2.5V9.7a5.7 5.7 0 1 0 4.9 5.7V9.1a7.4 7.4 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6Z' },
].filter((s) => SOCIAL[s.key as keyof typeof SOCIAL]);
---
<footer class="mt-24 border-t border-bordure bg-surface">
	<div class="conteneur py-12 sm:py-16">
		<div class="grid gap-10 md:grid-cols-12">
			<div class="md:col-span-4">
				<a href="/" aria-label="Accueil"><Logo /></a>
				<p class="mt-4 max-w-sm text-sm leading-relaxed text-attenue">{SITE.description}</p>
				{socials.length > 0 && (
					<ul class="mt-6 flex gap-2">
						{socials.map((s) => (
							<li>
								<a
									href={SOCIAL[s.key as keyof typeof SOCIAL]}
									target="_blank"
									rel="noopener me"
									aria-label={s.label}
									class="grid h-10 w-10 place-items-center rounded-xl text-attenue transition hover:bg-surface-2 hover:text-accent"
								>
									<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
								</a>
							</li>
						))}
					</ul>
				)}
			</div>

			<nav class="md:col-span-3" aria-label="Catégories">
				<h2 class="font-sans text-sm font-semibold text-texte">Catégories</h2>
				<ul class="mt-4 space-y-3">
					{CATEGORIES.map((c) => (
						<li><a href={`/categorie/${c.slug}`} class="text-sm text-attenue transition hover:text-accent">{c.name}</a></li>
					))}
				</ul>
			</nav>

			<nav class="md:col-span-3" aria-label="Le site">
				<h2 class="font-sans text-sm font-semibold text-texte">Le site</h2>
				<ul class="mt-4 space-y-3">
					{FOOTER_LINKS.site.map((l) => (
						<li><a href={l.href} class="text-sm text-attenue transition hover:text-accent">{l.label}</a></li>
					))}
				</ul>
			</nav>

			<nav class="md:col-span-2" aria-label="Informations légales">
				<h2 class="font-sans text-sm font-semibold text-texte">Légal</h2>
				<ul class="mt-4 space-y-3">
					{FOOTER_LINKS.legal.map((l) => (
						<li><a href={l.href} class="text-sm text-attenue transition hover:text-accent">{l.label}</a></li>
					))}
					<li>
						<button type="button" data-cookie-settings class="text-left text-sm text-attenue transition hover:text-accent">Gérer les cookies</button>
					</li>
				</ul>
			</nav>
		</div>

		<div class="mt-12 flex flex-col gap-2 border-t border-bordure pt-8 text-sm text-attenue sm:flex-row sm:items-center sm:justify-between">
			<p>© {year} {SITE.name}. Tous droits réservés.</p>
			<p>Fait avec ❤️ pour la jeunesse africaine.</p>
		</div>
	</div>
</footer>

---
/**
 * Encart de capture de courriels (Newsletter) optimisé pour la conversion.
 * Peut être utilisé en bas d'article ou sur la page d'accueil.
 */
interface Props {
	id?: string;
	title?: string;
	description?: string;
	class?: string;
}

const {
	id = 'newsletter',
	title = "Recevez nos guides IA directement par e-mail",
	description = "Une sélection hebdomadaire d'outils gratuits, de formations accessibles et d'opportunités concrètes pour progresser avec l'IA.",
	class: className = '',
} = Astro.props;
---

<section
	id={id}
	class:list={[
		'relative my-12 overflow-hidden rounded-3xl border border-bordure bg-surface p-8 sm:p-12 shadow-sm',
		className,
	]}
>
	<!-- Dégradé subtil en arrière-plan -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-terracotta-500/10 blur-3xl dark:bg-terracotta-500/15"
	></div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -bottom-16 -left-16 h-64 w-64 rounded-full bg-ocre-500/10 blur-3xl dark:bg-ocre-500/15"
	></div>

	<div class="relative mx-auto max-w-2xl text-center">
		<span class="surtitre">Newsletter gratuite</span>
		<h2 class="mt-2 text-2xl font-semibold leading-tight text-texte sm:text-3xl">
			{title}
		</h2>
		<p class="mt-3 text-sm leading-relaxed text-attenue sm:text-base">
			{description}
		</p>

		<form
			class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center"
			onsubmit="event.preventDefault(); const msg = this.querySelector('[data-newsletter-feedback]'); if(msg) { msg.classList.remove('hidden'); this.reset(); }"
		>
			<div class="relative flex-1 sm:max-w-md">
				<label for={`email-${id}`} class="sr-only">Adresse e-mail</label>
				<input
					type="email"
					id={`email-${id}`}
					name="email"
					required
					placeholder="Votre adresse e-mail (ex. vous@exemple.com)"
					class="w-full rounded-xl border border-bordure bg-surface-2/60 px-4 py-3 text-sm text-texte placeholder:text-attenue/70 focus:border-accent focus:bg-surface focus:outline-none focus:ring-2 focus:ring-accent/20"
				/>
			</div>
			<button type="submit" class="btn-primaire px-6 py-3 text-sm font-semibold">
				S'abonner
			</button>
		</form>

		<p data-newsletter-feedback class="mt-3 hidden text-xs font-medium text-emerald-600 dark:text-emerald-400">
			✓ Merci pour votre inscription ! Vous recevrez la prochaine édition.
		</p>

		<p class="mt-4 text-xs text-attenue">
			🔒 Garanti sans spam. Désinscription gratuite en 1 clic à tout moment.
		</p>
	</div>
</section>

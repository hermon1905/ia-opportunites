---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_STYLES, getCategory } from '../data/categories';
import { getPublishedPosts, formatDate, readingTime } from '../utils/posts';
import { getAuthor } from '../data/authors';
import NewsletterCta from '../components/NewsletterCta.astro';

const posts = await getPublishedPosts();
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const recentPosts = posts.filter((p) => p.id !== featuredPost?.id);
---

<BaseLayout>
	<!-- Hero / En-tête d'introduction -->
	<section class="relative overflow-hidden border-b border-bordure bg-surface/30">
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_50%_-10%,var(--color-terracotta-100),transparent)] dark:bg-[radial-gradient(60rem_30rem_at_50%_-10%,#3a1d12,transparent)]"></div>
		<div class="conteneur py-14 text-center sm:py-20">
			<p class="surtitre">IA & Jeunesse Africaine</p>
			<h1 class="mx-auto mt-3 max-w-3xl text-4xl font-semibold leading-tight sm:text-6xl">
				L'IA, une <span class="italic text-accent">opportunité</span> pour la jeunesse
			</h1>
			<p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-attenue sm:text-xl">
				Des guides concrets, des outils légers et des opportunités réelles pour apprendre, travailler et entreprendre avec l'intelligence artificielle.
			</p>
			<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
				<a href="/blog" class="btn-primaire px-6 py-3 text-base">Voir tous les articles ({posts.length})</a>
				<a href="/#newsletter" class="btn-secondaire px-6 py-3 text-base">Recevoir la newsletter</a>
			</div>
		</div>
	</section>

	<!-- Article à la une (si disponible) -->
	{featuredPost && (
		<section class="conteneur pt-12 sm:pt-16">
			<div class="mb-4 flex items-center justify-between">
				<p class="surtitre">À la une</p>
				<a href="/blog" class="text-sm font-medium text-accent hover:underline">Tous les articles &rarr;</a>
			</div>

			<article class="group grid overflow-hidden rounded-3xl border border-bordure bg-surface transition duration-300 hover:shadow-xl md:grid-cols-12">
				<div class="aspect-video md:aspect-auto md:col-span-7 overflow-hidden bg-surface-2">
					<Picture
						src={featuredPost.data.image}
						alt={featuredPost.data.imageAlt}
						widths={[480, 800, 1200]}
						sizes="(max-width: 768px) 100vw, 60vw"
						formats={['avif', 'webp']}
						class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
						loading="eager"
						fetchpriority="high"
					/>
				</div>

				<div class="flex flex-col justify-between p-6 sm:p-10 md:col-span-5">
					<div>
						<div class="flex items-center gap-2">
							{(() => {
								const cat = getCategory(featuredPost.data.category)!;
								return <span class:list={['etiquette', CATEGORY_STYLES[cat.color]]}>{cat.name}</span>;
							})()}
							<span class="text-xs text-attenue">{readingTime(featuredPost.body)} min de lecture</span>
						</div>

						<h2 class="mt-4 text-2xl font-semibold leading-snug sm:text-3xl group-hover:text-accent">
							<a href={`/blog/${featuredPost.id}`}>{featuredPost.data.title}</a>
						</h2>

						<p class="mt-3 text-sm leading-relaxed text-attenue sm:text-base">
							{featuredPost.data.description}
						</p>
					</div>

					<div class="mt-8 flex items-center justify-between border-t border-bordure pt-4 text-xs text-attenue">
						<span>{getAuthor(featuredPost.data.author).name}</span>
						<time datetime={featuredPost.data.pubDate.toISOString()}>{formatDate(featuredPost.data.pubDate)}</time>
					</div>
				</div>
			</article>
		</section>
	)}

	<!-- Derniers articles -->
	{recentPosts.length > 0 && (
		<section class="conteneur py-16">
			<div class="mb-8 flex items-center justify-between">
				<div>
					<p class="surtitre">Récemment publiés</p>
					<h2 class="mt-1 text-2xl font-semibold sm:text-3xl">Derniers articles</h2>
				</div>
				<a href="/blog" class="text-sm font-semibold text-accent hover:underline">Voir les {posts.length} articles &rarr;</a>
			</div>

			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-2">
				{recentPosts.map((post) => {
					const cat = getCategory(post.data.category)!;
					const author = getAuthor(post.data.author);
					const time = readingTime(post.body);

					return (
						<article class="group flex flex-col overflow-hidden rounded-2xl border border-bordure bg-surface transition duration-300 hover:-translate-y-1 hover:shadow-lg">
							<a href={`/blog/${post.id}`} class="block aspect-video overflow-hidden bg-surface-2">
								<Picture
									src={post.data.image}
									alt={post.data.imageAlt}
									widths={[360, 720]}
									sizes="(max-width: 640px) 100vw, 50vw"
									formats={['avif', 'webp']}
									class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
									loading="lazy"
								/>
							</a>

							<div class="flex flex-1 flex-col p-6">
								<div class="flex items-center justify-between gap-2">
									<span class:list={['etiquette', CATEGORY_STYLES[cat.color]]}>{cat.name}</span>
									<span class="text-xs text-attenue">{time} min</span>
								</div>

								<h3 class="mt-3 text-xl font-semibold leading-snug group-hover:text-accent">
									<a href={`/blog/${post.id}`}>{post.data.title}</a>
								</h3>

								<p class="mt-2.5 line-clamp-2 flex-1 text-sm text-attenue">
									{post.data.description}
								</p>

								<div class="mt-6 flex items-center justify-between border-t border-bordure/60 pt-4 text-xs text-attenue">
									<span>{author.name}</span>
									<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
								</div>
							</div>
						</article>
					);
				})}
			</div>
		</section>
	)}

	<div class="conteneur pb-16">
		<NewsletterCta />
	</div>
</BaseLayout>

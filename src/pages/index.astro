---
/**
 * Page d'accueil : /
 * Étape 5 : mise en page soignée, article à la une, exploration par thématique,
 * derniers articles avec ArticleCard, et encart newsletter.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterCta from '../components/NewsletterCta.astro';
import { CATEGORIES, CATEGORY_STYLES } from '../data/categories';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const recentPosts = posts.filter((p) => p.id !== featuredPost?.id);
---

<BaseLayout>
	<!-- Hero / En-tête d'introduction -->
	<section class="relative overflow-hidden border-b border-bordure bg-surface/30">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_50%_-10%,var(--color-terracotta-100),transparent)] dark:bg-[radial-gradient(60rem_30rem_at_50%_-10%,#3a1d12,transparent)]"
		></div>
		<div class="conteneur py-14 text-center sm:py-20">
			<p class="surtitre">IA & Jeunesse Africaine</p>
			<h1 class="mx-auto mt-3 max-w-3xl text-4xl font-semibold leading-tight sm:text-6xl">
				L'IA, une <span class="italic text-accent">opportunité</span> pour la jeunesse
			</h1>
			<p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-attenue sm:text-xl">
				Des guides concrets, des outils légers et des opportunités réelles pour apprendre, travailler et entreprendre avec l'intelligence artificielle.
			</p>
			<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
				<a href="/blog" class="btn-primaire px-6 py-3 text-base">Voir tous les articles ({posts.length})</a>
				<a href="/#newsletter" class="btn-secondaire px-6 py-3 text-base">Recevoir la newsletter</a>
			</div>
		</div>
	</section>

	<!-- Article à la une (si disponible) -->
	{featuredPost && (
		<section class="conteneur pt-12 sm:pt-16">
			<div class="mb-4 flex items-center justify-between">
				<div class="flex items-center gap-2">
					<span class="flex h-2.5 w-2.5 rounded-full bg-accent animate-pulse"></span>
					<p class="surtitre">À la une</p>
				</div>
				<a href="/blog" class="text-sm font-semibold text-accent hover:underline">
					Tous les articles &rarr;
				</a>
			</div>

			<ArticleCard post={featuredPost} featured={true} />
		</section>
	)}

	<!-- Navigation par catégories thématiques -->
	<section class="conteneur pt-16">
		<div class="mb-6 flex items-center justify-between">
			<div>
				<p class="surtitre">Thématiques</p>
				<h2 class="mt-1 text-2xl font-semibold sm:text-3xl">Explorer par sujet</h2>
			</div>
			<a href="/blog" class="text-sm font-semibold text-accent hover:underline">
				Tout voir &rarr;
			</a>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{CATEGORIES.map((cat) => {
				const count = posts.filter((p) => p.data.category === cat.slug).length;
				return (
					<a
						href={`/categorie/${cat.slug}`}
						class="group flex flex-col justify-between rounded-2xl border border-bordure bg-surface p-5 transition duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-surface-2"
					>
						<div>
							<div class="flex items-center justify-between gap-2">
								<span class:list={['etiquette', CATEGORY_STYLES[cat.color]]}>
									{cat.name}
								</span>
								<span class="text-xs text-attenue">
									{count} article{count > 1 ? 's' : ''}
								</span>
							</div>
							<p class="mt-3 text-sm leading-relaxed text-attenue">
								{cat.description}
							</p>
						</div>
						<div class="mt-4 flex items-center gap-1 text-xs font-semibold text-accent opacity-0 transition group-hover:opacity-100">
							<span>Découvrir</span>
							<span>&rarr;</span>
						</div>
					</a>
				);
			})}
		</div>
	</section>

	<!-- Derniers articles publiés -->
	{recentPosts.length > 0 && (
		<section class="conteneur py-16">
			<div class="mb-8 flex items-center justify-between">
				<div>
					<p class="surtitre">Récemment publiés</p>
					<h2 class="mt-1 text-2xl font-semibold sm:text-3xl">Derniers articles</h2>
				</div>
				<a href="/blog" class="text-sm font-semibold text-accent hover:underline">
					Voir les {posts.length} articles &rarr;
				</a>
			</div>

			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-2">
				{recentPosts.map((post) => (
					<ArticleCard post={post} />
				))}
			</div>
		</section>
	)}

	<!-- Encart Newsletter -->
	<div class="conteneur pb-16">
		<NewsletterCta />
	</div>
</BaseLayout>

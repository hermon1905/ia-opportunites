---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_STYLES, getCategory } from '../data/categories';
import { getPublishedPosts, formatDate } from '../utils/posts';

const posts = await getPublishedPosts();

// Aperçu temporaire du design (sera remplacé par la vraie page d'accueil à l'étape 5)
const palettes = ['terracotta', 'ocre', 'foret', 'sable'];
const shades = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
---
<BaseLayout>
	<!-- Bandeau d'introduction -->
	<section class="relative overflow-hidden">
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_50%_-10%,var(--color-terracotta-100),transparent)] dark:bg-[radial-gradient(60rem_30rem_at_50%_-10%,#3a1d12,transparent)]"></div>
		<div class="conteneur py-16 text-center sm:py-24">
			<p class="surtitre">Le blog</p>
			<h1 class="mx-auto mt-3 max-w-3xl text-4xl font-semibold leading-tight sm:text-6xl">
				L'IA, une <span class="italic text-accent">opportunité</span> pour la jeunesse africaine
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-attenue sm:text-xl">
				Des guides concrets, des outils testés et des histoires inspirantes pour apprendre, travailler et entreprendre avec l'intelligence artificielle.
			</p>
			<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
				<a href="/blog" class="btn-primaire px-6 py-3 text-base">Lire les articles</a>
				<a href="/#newsletter" class="btn-secondaire px-6 py-3 text-base">Recevoir la newsletter</a>
			</div>
		</div>
	</section>

	<!-- LISTE DES ARTICLES — temporaire (vraie mise en page à l'étape 5) -->
	<section class="conteneur mb-12">
		<h2 class="text-2xl font-semibold">Articles ({posts.length})</h2>
		<ul class="mt-4 divide-y divide-bordure rounded-2xl border border-bordure bg-surface">
			{posts.map((p) => (
				<li>
					<a href={`/blog/${p.id}`} class="flex flex-col gap-1 p-4 hover:bg-surface-2 sm:flex-row sm:items-center sm:justify-between">
						<span class="font-medium">{p.data.title}{p.data.draft && ' (brouillon)'}</span>
						<span class="text-sm text-attenue">{getCategory(p.data.category)?.name} · {formatDate(p.data.pubDate)}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<!-- APERÇU DU DESIGN — temporaire -->
	<section class="conteneur">
		<div class="rounded-3xl border border-dashed border-bordure bg-surface p-6 sm:p-10">
			<p class="surtitre">Aperçu du design (temporaire)</p>
			<h2 class="mt-2 text-2xl font-semibold sm:text-3xl">Catégories, boutons et palette</h2>

			<div class="mt-6 flex flex-wrap gap-2">
				{CATEGORIES.map((c) => <span class:list={['etiquette', CATEGORY_STYLES[c.color]]}>{c.name}</span>)}
			</div>

			<div class="mt-6 flex flex-wrap gap-3">
				<button class="btn-primaire">Bouton principal</button>
				<button class="btn-secondaire">Bouton secondaire</button>
				<a href="#" class="font-semibold text-accent underline-offset-4 hover:underline">Un lien</a>
			</div>

			<div class="mt-8 space-y-3">
				{palettes.map((p) => (
					<div class="flex items-center gap-3">
						<span class="w-24 shrink-0 text-sm capitalize text-attenue">{p}</span>
						<div class="grid flex-1 grid-cols-11 overflow-hidden rounded-lg">
							{shades.map((s) => <div class="h-8" style={`background: var(--color-${p}-${s})`} title={`${p}-${s}`}></div>)}
						</div>
					</div>
				))}
			</div>

			<article class="prose prose-stone mt-10 max-w-none dark:prose-invert">
				<h3>Exemple de texte d'article</h3>
				<p>Voici à quoi ressemblera un paragraphe d'article. La police <strong>Inter</strong> est très lisible sur petit écran, tandis que <em>Fraunces</em> donne du caractère aux titres. Le contraste respecte les normes d'accessibilité, en mode clair comme en mode sombre.</p>
			</article>
		</div>
	</section>
</BaseLayout>

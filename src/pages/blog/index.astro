---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, readingTime, formatDate } from '../../utils/posts';
import { CATEGORIES, CATEGORY_STYLES, getCategory } from '../../data/categories';
import { getAuthor } from '../../data/authors';

const posts = await getPublishedPosts();
---

<BaseLayout
	title="Tous les articles"
	description="Explorez tous nos articles, guides pratiques et analyses sur l'intelligence artificielle et les opportunités pour la jeunesse."
>
	<header class="border-b border-bordure bg-surface/50 py-12 sm:py-16">
		<div class="conteneur">
			<p class="surtitre">Le blog</p>
			<h1 class="mt-2 text-3xl font-semibold sm:text-5xl">Tous les articles</h1>
			<p class="mt-3 max-w-2xl text-base text-attenue sm:text-lg">
				Guides pratiques, outils légers et opportunités concrètes pour se former et entreprendre avec l'IA.
			</p>

			<!-- Filtres par catégorie -->
			<div class="mt-8 flex flex-wrap gap-2">
				<a href="/blog" class="etiquette bg-accent text-white dark:text-sable-950">Tous ({posts.length})</a>
				{CATEGORIES.map((c) => {
					const count = posts.filter((p) => p.data.category === c.slug).length;
					return (
						<a href={`/categorie/${c.slug}`} class:list={['etiquette transition hover:opacity-80', CATEGORY_STYLES[c.color]]}>
							{c.name} ({count})
						</a>
					);
				})}
			</div>
		</div>
	</header>

	<main class="conteneur py-12">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => {
				const cat = getCategory(post.data.category)!;
				const author = getAuthor(post.data.author);
				const time = readingTime(post.body);

				return (
					<article class="group flex flex-col overflow-hidden rounded-2xl border border-bordure bg-surface transition duration-300 hover:-translate-y-1 hover:shadow-lg">
						<a href={`/blog/${post.id}`} class="block aspect-video overflow-hidden bg-surface-2">
							<Picture
								src={post.data.image}
								alt={post.data.imageAlt}
								widths={[360, 600]}
								sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
								formats={['avif', 'webp']}
								class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
								loading="lazy"
							/>
						</a>

						<div class="flex flex-1 flex-col p-6">
							<div class="flex items-center justify-between gap-2">
								<a href={`/categorie/${cat.slug}`} class:list={['etiquette', CATEGORY_STYLES[cat.color]]}>
									{cat.name}
								</a>
								<span class="text-xs text-attenue">{time} min</span>
							</div>

							<h2 class="mt-3 text-xl font-semibold leading-snug group-hover:text-accent">
								<a href={`/blog/${post.id}`} class="focus:outline-none">
									{post.data.title}
								</a>
							</h2>

							<p class="mt-2.5 line-clamp-2 flex-1 text-sm text-attenue">
								{post.data.description}
							</p>

							<div class="mt-6 flex items-center justify-between border-t border-bordure/60 pt-4 text-xs text-attenue">
								<span>{author.name}</span>
								<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							</div>
						</div>
					</article>
				);
			})}
		</div>
	</main>
</BaseLayout>

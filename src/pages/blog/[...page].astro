---
/**
 * Page catalogue de tous les articles avec pagination : /blog et /blog/[page]
 * Étape 5 : navigation complète, filtres par catégorie, pagination.
 */
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';
import { CATEGORIES, CATEGORY_STYLES } from '../../data/categories';
import { SITE } from '../../config';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const posts = await getPublishedPosts();
	return paginate(posts, {
		pageSize: SITE.postsPerPage,
		props: { allPosts: posts },
	});
}

interface Props {
	page: Page<Post>;
	allPosts: Post[];
}

const { page, allPosts } = Astro.props;
---

<BaseLayout
	title={page.currentPage > 1 ? `Tous les articles — Page ${page.currentPage}` : 'Tous les articles'}
	description="Explorez tous nos articles, guides pratiques et analyses sur l'intelligence artificielle et les opportunités pour la jeunesse."
>
	<!-- En-tête du catalogue -->
	<header class="border-b border-bordure bg-surface/50 py-12 sm:py-16">
		<div class="conteneur">
			<p class="surtitre">Le catalogue</p>
			<h1 class="mt-2 text-3xl font-semibold sm:text-5xl">Tous les articles</h1>
			<p class="mt-3 max-w-2xl text-base text-attenue sm:text-lg">
				Guides pratiques, outils légers et opportunités concrètes pour se former et entreprendre avec l'IA.
			</p>

			<!-- Barre de filtres par catégorie avec compteurs -->
			<div class="mt-8 flex flex-wrap items-center gap-2">
				<a
					href="/blog"
					class="etiquette bg-accent text-white shadow-sm dark:text-sable-950"
				>
					Tous ({allPosts.length})
				</a>
				{CATEGORIES.map((c) => {
					const count = allPosts.filter((p) => p.data.category === c.slug).length;
					return (
						<a
							href={`/categorie/${c.slug}`}
							class:list={[
								'etiquette transition duration-200 hover:scale-105 hover:opacity-90',
								CATEGORY_STYLES[c.color],
							]}
						>
							{c.name} ({count})
						</a>
					);
				})}
			</div>
		</div>
	</header>

	<!-- Liste des articles -->
	<main class="conteneur py-12">
		{page.data.length === 0 ? (
			<div class="rounded-3xl border border-dashed border-bordure bg-surface p-12 text-center">
				<p class="text-lg font-medium text-texte">Aucun article publié pour le moment.</p>
				<p class="mt-2 text-sm text-attenue">Les prochains articles paraîtront très bientôt.</p>
			</div>
		) : (
			<div>
				<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
					{page.data.map((post) => (
						<ArticleCard post={post} />
					))}
				</div>

				<!-- Composant Pagination -->
				<Pagination
					currentPage={page.currentPage}
					lastPage={page.lastPage}
					prevUrl={page.url.prev}
					nextUrl={page.url.next}
					baseUrl="/blog"
				/>
			</div>
		)}
	</main>
</BaseLayout>

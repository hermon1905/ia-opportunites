---
/**
 * Page Formations : /formations
 * Présentation des formations exclusives et programmes pratiques.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import formationVideosIa from '../assets/boutique/formation-videos-ia.png';
import digitalEmpireStarter from '../assets/boutique/digital-empire-starter.jpg';
import botsTradingIa from '../assets/boutique/bots-trading-ia.jpg';
import academieProduitsDigitaux from '../assets/boutique/academie-produits-digitaux.png';

const products = [
	{
		id: 'formation-videos-ia',
		badge: 'Formation Exclusive',
		badgeColor: 'bg-amber-500/10 text-amber-600 ring-1 ring-amber-500/30 dark:bg-amber-500/20 dark:text-amber-300 dark:ring-amber-400/40',
		title: 'Crée des Vidéos IA Ultra-Réalistes qui Vendent pour Toi',
		description: 'La méthode pas-à-pas pour générer des vidéos captivantes et des visages photoréalistes depuis ton téléphone en moins de 2 heures, pour booster tes ventes ou te lancer en freelance.',
		image: formationVideosIa,
		imageAlt: 'Formation Exclusive : Crée des Vidéos IA Ultra-Réalistes qui Vendent pour Toi',
		url: 'https://chariow.ly/T8Q9VAD5R1',
		isExternal: true,
		features: [
			'Création d’avatars et visages IA ultra-réalistes',
			'Animation vidéo & synchronisation labiale (lip-sync)',
			'Bonus inclus : +300 Prompts IA prêts à copier',
			'100% réalisable depuis ton smartphone en moins de 2 heures',
			'Accès immédiat et visionnage à vie',
		],
		cta: 'Accéder à la formation maintenant',
	},
	{
		id: 'digital-empire-starter',
		badge: 'Pack Business Complet',
		badgeColor: 'bg-emerald-500/10 text-emerald-600 ring-1 ring-emerald-500/30 dark:bg-emerald-500/20 dark:text-emerald-300 dark:ring-emerald-400/40',
		title: 'DIGITAL EMPIRE STARTER',
		description: 'Voici TOUT ce que vous obtiendrez en rejoignant DIGITAL EMPIRE STARTER dès aujourd’hui pour lancer votre business automatisé de vente de produits digitaux :',
		image: digitalEmpireStarter,
		imageAlt: 'Formation DIGITAL EMPIRE STARTER : Vente de Produits Digitaux et Automatisation',
		url: 'https://chariow.ly/6TI3ENS7M0',
		isExternal: true,
		features: [
			'Module 1 : Le Business de Vente de Produits Digitaux',
			'Module 2 : Identifier une Niche Rentable',
			'Module 3 : Créer Ton Produit Digital en 2H',
			'Module 4 : Mettre en Place ton Système Automatisé',
			'Module 5 : Attirer des Acheteurs (Sans Budget Pub)',
			'Module 6 : Lancer Des Publicités Facebook ads',
			'Bonus 2 : Système Automatisé en 1 Clic (Vendre en dormant)',
			'Bonus 3 : Pack “Contenu Viral” Prêt à l’emploi',
			'Bonus 4 : Templates Puissants & Prêts à l’Emploi',
			'Bonus 5 : Protocole Clients Satisfaits',
		],
		cta: 'Rejoindre DIGITAL EMPIRE STARTER',
	},
	{
		id: 'bots-trading-ia',
		badge: 'Finance & IA',
		badgeColor: 'bg-sky-500/10 text-sky-600 ring-1 ring-sky-500/30 dark:bg-sky-500/20 dark:text-sky-300 dark:ring-sky-400/40',
		title: 'Comment Gagner de l’Argent avec les Bots de TRADING IA',
		description: 'Apprends à configurer et exploiter des algorithmes de trading automatisés (+650$/mois) avec une gestion rigoureuse du risque et des retraits Mobile Money.',
		image: botsTradingIa,
		imageAlt: 'Formation Comment Gagner de l’Argent avec les Bots de TRADING IA en 2026',
		url: 'https://chariow.ly/0VKGU91CQ2',
		isExternal: true,
		features: [
			'Configuration pas-à-pas des bots de trading algorithmique',
			'Stratégies éprouvées & gestion stricte du risque financier',
			'Dépôts et retraits directs par Mobile Money (Orange, MTN, Moov)',
			'100% pilotable et configurable depuis un smartphone',
			'Mises à jour régulières des algorithmes & communauté',
		],
		cta: 'Accéder à la formation Trading IA',
	},
	{
		id: 'academie-produits-digitaux',
		badge: 'Niveau Débutant · +100 Avis',
		badgeColor: 'bg-indigo-500/10 text-indigo-600 ring-1 ring-indigo-500/30 dark:bg-indigo-500/20 dark:text-indigo-300 dark:ring-indigo-400/40',
		title: 'Académie des Produits Digitaux : 10 Millions par an',
		description: 'Le programme complet pour créer ton premier produit digital, lancer une boutique en ligne en quelques clics et générer des ventes avec Facebook Ads sans être un expert.',
		image: academieProduitsDigitaux,
		imageAlt: 'Académie des Produits Digitaux : 10 Millions par an avec les Produits Digitaux',
		url: 'https://chariow.ly/OCSED6XU81',
		isExternal: true,
		features: [
			'Vidéos de formation pas à pas (100% accessible sur mobile)',
			'Des sessions lives & accompagnement régulier',
			'Des ressources pratiques & templates prêts à l’emploi',
			'Créer ton premier produit digital en quelques clics',
			'Lancer une boutique et des publicités rentables',
			'Accès à vie & communauté (+100 avis positifs)',
		],
		cta: 'Rejoindre l’Académie des Produits Digitaux',
	},
];
---

<BaseLayout
	title="Formations & Guides Pratiques"
	description="Découvrez nos formations exclusives et programmes pratiques pour maîtriser l'IA sur smartphone, lancer un business digital et générer des revenus."
>
	<header class="border-b border-bordure bg-surface/50 py-10 sm:py-14">
		<div class="conteneur max-w-5xl">
			<Breadcrumbs items={[{ label: 'Formations' }]} class="mb-5" />
			<p class="surtitre">Formations & Ressources</p>
			<h1 class="mt-2 text-2xl font-semibold sm:text-4xl">Formations & Guides Pratiques</h1>
			<p class="mt-2.5 max-w-2xl text-sm text-attenue sm:text-base">
				Des compétences immédiatement rentables et applicables sur smartphone, conçues pour les créateurs, commerçants et entrepreneurs digitaux.
			</p>
		</div>
	</header>

	<main class="conteneur max-w-5xl py-10 sm:py-14">
		<!-- Réassurance sur le paiement -->
		<div class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-bordure bg-surface-2/60 p-4 sm:p-5 text-xs sm:text-sm text-attenue">
			<div class="flex items-center gap-2">
				<span class="text-base">💳</span>
				<span>Paiement sécurisé par <strong>Mobile Money</strong> (Wave, Orange, MTN, Moov) et Carte bancaire</span>
			</div>
			<div class="flex items-center gap-2">
				<span class="text-base">⚡</span>
				<span>Accès immédiat après commande</span>
			</div>
		</div>

		<!-- Grille des formations (format équilibré respectant les formes initiales) -->
		<div class="grid gap-6 sm:grid-cols-2">
			{products.map((item) => (
				<article class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-bordure bg-surface p-5 sm:p-6 shadow-sm transition duration-300 hover:shadow-xl hover:border-accent/30">
					<div>
						<!-- Visuel de la formation au format initial non rogné -->
						{item.image && (
							<a
								href={item.url}
								target={item.isExternal ? '_blank' : undefined}
								rel={item.isExternal ? 'noopener noreferrer' : undefined}
								class="block overflow-hidden rounded-2xl border border-bordure/80 bg-surface-2/50 shadow-sm transition duration-300 group-hover:shadow-md mb-5"
							>
								<Image
									src={item.image}
									alt={item.imageAlt || item.title}
									quality={95}
									class="w-full h-auto block rounded-2xl transition duration-300 group-hover:scale-[1.01]"
									loading="eager"
								/>
							</a>
						)}

						<div class="flex items-center justify-between gap-2">
							<span class:list={['etiquette font-semibold', item.badgeColor]}>{item.badge}</span>
						</div>

						<h2 class="mt-3.5 text-lg sm:text-xl font-semibold leading-snug text-texte transition group-hover:text-accent">
							<a
								href={item.url}
								target={item.isExternal ? '_blank' : undefined}
								rel={item.isExternal ? 'noopener noreferrer' : undefined}
								class="focus:outline-none"
							>
								{item.title}
							</a>
						</h2>

						<p class="mt-2 text-xs sm:text-sm leading-relaxed text-attenue">
							{item.description}
						</p>

						<div class="mt-4 border-t border-bordure/60 pt-4">
							<p class="text-xs font-semibold uppercase tracking-wider text-texte">Au programme :</p>
							<ul class="mt-2.5 space-y-2 text-xs text-attenue">
								{item.features.map((feat) => (
									<li class="flex items-start gap-2">
										<span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
										<span>{feat}</span>
									</li>
								))}
							</ul>
						</div>
					</div>

					<div class="mt-6 border-t border-bordure/60 pt-4">
						<a
							href={item.url}
							target={item.isExternal ? '_blank' : undefined}
							rel={item.isExternal ? 'noopener noreferrer' : undefined}
							class="btn-primaire w-full py-3 text-center text-xs sm:text-sm font-semibold inline-flex items-center justify-center gap-1.5 shadow-md transition duration-200 hover:scale-[1.01]"
						>
							<span>{item.cta}</span>
							{item.isExternal && (
								<span aria-hidden="true" class="text-base">&nearr;</span>
							)}
						</a>
						<p class="mt-2 text-center text-[11px] text-attenue">
							Paiement sécurisé via Chariow (Mobile Money & Carte)
						</p>
					</div>
				</article>
			))}
		</div>

		<!-- FAQ Boutique -->
		<section class="mt-20 border-t border-bordure pt-12">
			<h2 class="text-2xl font-semibold text-texte">Questions fréquentes sur les formations</h2>
			<div class="mt-6 grid gap-6 sm:grid-cols-2">
				<div class="rounded-2xl border border-bordure bg-surface p-6">
					<h3 class="font-semibold text-texte text-sm sm:text-base">Comment se déroulent les formations ?</h3>
					<p class="mt-2 text-xs sm:text-sm text-attenue leading-relaxed">
						Toutes nos formations sont 100% en ligne et accessibles immédiatement après paiement sur la plateforme Chariow. Vous pouvez suivre chaque étape pas-à-pas directement depuis votre smartphone ou votre ordinateur.
					</p>
				</div>
				<div class="rounded-2xl border border-bordure bg-surface p-6">
					<h3 class="font-semibold text-texte text-sm sm:text-base">Quels moyens de paiement sont acceptés ?</h3>
					<p class="mt-2 text-xs sm:text-sm text-attenue leading-relaxed">
						Chariow accepte tous les principaux comptes Mobile Money (Wave, Orange Money, MTN MoMo, Moov Money) ainsi que les cartes bancaires Visa et Mastercard internationales.
					</p>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

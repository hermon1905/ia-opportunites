---
/**
 * Page d'erreur 404 : /404
 * Accueillante, rassurante et orientée vers la découverte du blog.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout
	title="Page non trouvée (Erreur 404)"
	description="Oups ! La page demandée semble introuvable. Retrouvez tous nos articles et guides sur l'IA."
	noindex={true}
>
	<main class="conteneur max-w-3xl py-16 sm:py-24 text-center">
		<!-- Code 404 stylisé -->
		<div class="mx-auto flex h-24 w-24 items-center justify-center rounded-3xl bg-accent-doux text-4xl font-bold font-display text-accent shadow-inner">
			404
		</div>

		<h1 class="mt-6 text-3xl font-semibold sm:text-5xl">Cette page semble introuvable</h1>
		<p class="mx-auto mt-4 max-w-lg text-base text-attenue sm:text-lg">
			L'adresse a peut-être changé, le lien est expiré ou une lettre s'est glissée par erreur dans l'URL.
		</p>

		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="btn-primaire px-6 py-3">Retour à l'accueil</a>
			<a href="/blog" class="btn-secondaire px-6 py-3">Voir tous les articles</a>
		</div>

		<!-- Recommandations d'articles populaires -->
		{recentPosts.length > 0 && (
			<div class="mt-16 border-t border-bordure pt-10 text-left">
				<p class="surtitre text-center sm:text-left">Pour continuer votre lecture</p>
				<h2 class="mt-1 text-xl font-semibold text-center sm:text-left text-texte">Ces articles pourraient vous intéresser :</h2>

				<ul class="mt-6 divide-y divide-bordure rounded-2xl border border-bordure bg-surface">
					{recentPosts.map((post) => (
						<li>
							<a
								href={`/blog/${post.id}`}
								class="flex items-center justify-between p-4 transition hover:bg-surface-2 group"
							>
								<span class="font-medium text-sm text-texte group-hover:text-accent line-clamp-1">
									{post.data.title}
								</span>
								<span class="text-xs font-semibold text-accent shrink-0 ml-4">&rarr;</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}
	</main>
</BaseLayout>

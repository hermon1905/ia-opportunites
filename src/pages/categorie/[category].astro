---
/**
 * Page d'une catégorie : /categorie/[category]
 * Étape 5 : liste filtrée, fil d'Ariane, cartes d'articles et état vide soigné.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedPosts } from '../../utils/posts';
import { CATEGORIES, CATEGORY_STYLES } from '../../data/categories';

export async function getStaticPaths() {
	const allPosts = await getPublishedPosts();
	return CATEGORIES.map((cat) => ({
		params: { category: cat.slug },
		props: {
			category: cat,
			posts: allPosts.filter((p) => p.data.category === cat.slug),
		},
	}));
}

interface Props {
	category: (typeof CATEGORIES)[number];
	posts: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { category, posts } = Astro.props;
---

<BaseLayout
	title={`${category.name} — Articles`}
	description={category.description}
>
	<!-- En-tête de la catégorie -->
	<header class="border-b border-bordure bg-surface/50 py-12 sm:py-16">
		<div class="conteneur">
			<!-- Fil d'Ariane -->
			<Breadcrumbs
				items={[
					{ label: 'Articles', href: '/blog' },
					{ label: category.name },
				]}
				class="mb-6"
			/>

			<div class="flex items-center gap-3">
				<span class:list={['etiquette text-sm px-3 py-1', CATEGORY_STYLES[category.color]]}>
					{category.name}
				</span>
				<span class="text-sm font-medium text-attenue">
					{posts.length} article{posts.length > 1 ? 's' : ''}
				</span>
			</div>

			<h1 class="mt-4 text-3xl font-semibold sm:text-5xl">{category.name}</h1>
			<p class="mt-3 max-w-2xl text-base text-attenue sm:text-lg">
				{category.description}
			</p>
		</div>
	</header>

	<!-- Liste des articles ou état vide -->
	<main class="conteneur py-12">
		{posts.length === 0 ? (
			<div class="rounded-3xl border border-dashed border-bordure bg-surface p-12 text-center max-w-xl mx-auto">
				<div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-2 text-2xl">
					✍️
				</div>
				<h2 class="mt-4 text-xl font-semibold text-texte">Aucun article dans cette catégorie pour le moment</h2>
				<p class="mt-2 text-sm text-attenue">
					Nos prochains dossiers et guides sur « {category.name} » sont en cours de rédaction.
				</p>
				<div class="mt-6 flex flex-wrap justify-center gap-3">
					<a href="/blog" class="btn-primaire">Explorer les autres articles</a>
					<a href="/#newsletter" class="btn-secondaire">Être alerté par e-mail</a>
				</div>
			</div>
		) : (
			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => (
					<ArticleCard post={post} />
				))}
			</div>
		)}
	</main>
</BaseLayout>

---
/**
 * Page Partenariats : /partenariats
 * Propositions de collaboration, sponsoring et interventions.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config';

const offers = [
	{
		title: 'Article sponsorisé & Test produit',
		description: 'Une présentation approfondie de votre outil ou service avec des cas d’usage concrets adaptés aux réalités du public africain.',
		points: [
			'Article détaillé de 1 200 à 2 000 mots',
			'Mise en avant sur l’accueil et dans la newsletter',
			'Partage sur nos canaux de diffusion WhatsApp et réseaux sociaux',
			'Lien pérenne et indexé',
		],
	},
	{
		title: 'Sponsoring de la Newsletter',
		description: 'Un encart dédié en tête ou au cœur de notre lettre d’information hebdomadaire lue par une communauté de jeunes très engagés.',
		points: [
			'Texte de présentation de 80 à 120 mots avec bouton d’action',
			'Taux d’ouverture moyen supérieur à 40%',
			'Exclusivité sur l’édition sélectionnée',
			'Statistiques de clics fournies post-envoi',
		],
	},
	{
		title: 'Ateliers & Webémissions',
		description: 'Animation d’ateliers pratiques ou de conférences en ligne sur la prise en main de l’IA, le prompt engineering et les métiers du futur.',
		points: [
			'Session interactive en direct de 1h30 à 2h',
			'Supports de cours remis aux participants',
			'Adapté aux universités, incubateurs et entreprises',
		],
	},
];
---

<BaseLayout
	title="Partenariats & Sponsoring"
	description="Associez votre marque à l'émancipation technologique des jeunes en Afrique via nos offres de sponsoring et d'ateliers."
>
	<header class="border-b border-bordure bg-surface/50 py-12 sm:py-16">
		<div class="conteneur max-w-5xl">
			<Breadcrumbs items={[{ label: 'Partenariats' }]} class="mb-6" />
			<p class="surtitre">Collaborations</p>
			<h1 class="mt-2 text-3xl font-semibold sm:text-5xl">Travailler avec nous</h1>
			<p class="mt-3 max-w-2xl text-base text-attenue sm:text-lg">
				Donnez de la visibilité à vos projets, sensibilisez les futurs talents et soutenez une communauté tech ambitieuse.
			</p>
		</div>
	</header>

	<main class="conteneur max-w-5xl py-12 sm:py-16">
		<!-- Nos valeurs / Ligne de conduite -->
		<div class="rounded-3xl border border-bordure bg-surface-2/60 p-8 sm:p-10">
			<h2 class="text-xl font-semibold text-texte">Notre ligne éthique</h2>
			<p class="mt-3 text-sm leading-relaxed text-attenue">
				La confiance de nos lecteurs est notre bien le plus précieux. Nous refusons systématiquement les promotions d'outils trompeurs, de plateformes de spéculation douteuses ou de services sans utilité démontrée. Tout partenariat fait l'objet d'une mention claire et transparente.
			</p>
		</div>

		<!-- Formules -->
		<section class="mt-16">
			<h2 class="text-2xl sm:text-3xl font-semibold text-texte">Nos formats d'intervention</h2>
			<div class="mt-8 grid gap-8 md:grid-cols-3">
				{offers.map((offer) => (
					<div class="flex flex-col justify-between rounded-3xl border border-bordure bg-surface p-7 shadow-sm">
						<div>
							<h3 class="text-lg font-semibold text-texte">{offer.title}</h3>
							<p class="mt-3 text-xs sm:text-sm text-attenue leading-relaxed">{offer.description}</p>
							<ul class="mt-6 space-y-2 border-t border-bordure/60 pt-6 text-xs text-attenue">
								{offer.points.map((pt) => (
									<li class="flex items-start gap-2">
										<span class="text-accent font-bold">✓</span>
										<span>{pt}</span>
									</li>
								))}
							</ul>
						</div>
						<div class="mt-8 border-t border-bordure/60 pt-6">
							<a href="/contact?sujet=partenariat" class="btn-secondaire w-full text-center text-xs font-semibold">
								Demander un devis &rarr;
							</a>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Appel à l'action -->
		<section class="mt-16 rounded-3xl border border-bordure bg-surface p-8 sm:p-12 text-center">
			<h2 class="text-2xl font-semibold text-texte">Vous avez un projet spécifique ?</h2>
			<p class="mx-auto mt-3 max-w-xl text-sm text-attenue">
				Contactez notre équipe pour concevoir une opération sur-mesure répondant à vos objectifs.
			</p>
			<a href="/contact?sujet=partenariat" class="btn-primaire mt-6 inline-flex px-8 py-3 text-sm">
				Discuter d'un partenariat
			</a>
		</section>
	</main>
</BaseLayout>
